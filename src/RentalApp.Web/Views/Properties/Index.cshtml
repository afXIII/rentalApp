@model IReadOnlyList<RentalApp.Web.Models.Properties.PropertyRowViewModel>
@{
    ViewData["Title"] = "Properties";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Properties</h1>
    <button type="button" class="btn btn-primary"
            data-modal-url="@Url.Action("Create")"
            data-refresh-target="#property-table" data-refresh-url="@Url.Action("Table")">
        Add property
    </button>
</div>

<partial name="_PropertyTable" model="Model" />
