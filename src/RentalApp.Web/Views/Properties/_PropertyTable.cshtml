@model IReadOnlyList<RentalApp.Web.Models.Properties.PropertyRowViewModel>
@{
    var refreshUrl = Url.Action("Table", "Properties");
}

<div id="property-table" class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Name</th>
                    <th>Address</th>
                    <th class="text-end">Units</th>
                    <th class="text-end">Available</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var property in Model)
                {
                    <tr>
                        <td><a asp-controller="Properties" asp-action="Details" asp-route-id="@property.Id">@property.Name</a></td>
                        <td>@property.Address</td>
                        <td class="text-end">@property.UnitCount</td>
                        <td class="text-end">@property.AvailableUnitCount</td>
                        <td class="text-end text-nowrap">
                            <button type="button" class="btn btn-sm btn-outline-secondary"
                                    data-modal-url="@Url.Action("Edit", "Properties", new { id = property.Id })"
                                    data-refresh-target="#property-table" data-refresh-url="@refreshUrl">Edit</button>
                            <button type="button" class="btn btn-sm btn-outline-danger"
                                    data-modal-url="@Url.Action("Delete", "Properties", new { id = property.Id })"
                                    data-refresh-target="#property-table" data-refresh-url="@refreshUrl">Remove</button>
                        </td>
                    </tr>
                }
                @if (Model.Count == 0)
                {
                    <tr><td colspan="5" class="text-center text-muted py-4">No properties yet.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
