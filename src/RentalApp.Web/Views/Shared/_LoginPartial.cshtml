@if (User.Identity?.IsAuthenticated == true)
{
    var roleLabel = User.IsInRole(Roles.PropertyManager) ? "Property manager" : "Applicant";
    <div class="d-flex align-items-center gap-3 text-white">
        <span class="small">@User.Identity.Name <span class="badge text-bg-light ms-1">@roleLabel</span></span>
        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
            <button type="submit" class="btn btn-sm btn-outline-light">Log out</button>
        </form>
    </div>
}
else
{
    <ul class="navbar-nav">
        <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Log in</a></li>
        <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Register">Sign up</a></li>
    </ul>
}
