<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RentalApp</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    @{
        var isManager = User.IsInRole(Roles.PropertyManager);
        var isApplicant = User.IsInRole(Roles.Applicant);
    }
    <header>
        <nav class="navbar navbar-expand-md navbar-dark bg-primary mb-4">
            <div class="container">
                <a class="navbar-brand fw-semibold" asp-controller="Home" asp-action="Index">RentalApp</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#main-nav"
                        aria-controls="main-nav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="main-nav">
                    <ul class="navbar-nav me-auto">
                        @if (isApplicant)
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="AvailableUnits" asp-action="Index">Available units</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Applications" asp-action="Index">My applications</a></li>
                        }
                        @if (isManager)
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Applications" asp-action="Index">Applications</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Applications" asp-action="Index" asp-route-status="@ApplicationStatus.Submitted">Review queue</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Properties" asp-action="Index">Properties</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="UnitTypes" asp-action="Index">Unit types</a></li>
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="container flex-grow-1 pb-4">
        <partial name="_Flash" />
        @RenderBody()
    </main>

    <footer class="border-top py-3 text-muted small">
        <div class="container">&copy; 2026 RentalApp</div>
    </footer>

    @* One shared modal. site.js loads partial views into it (see data-modal-url). *@
    <div class="modal fade" id="app-modal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content"></div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
