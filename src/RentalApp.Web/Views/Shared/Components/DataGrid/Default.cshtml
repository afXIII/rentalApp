@model RentalApp.Web.Models.Shared.GridDefinition
@using System.Text.Json
@{
    // Everything the script needs, serialized once. Rendered into an attribute, so Razor HTML-encodes it.
    var config = JsonSerializer.Serialize(new
    {
        dataUrl = Model.DataUrl,
        columns = Model.Columns.Select(c => new { key = c.Key, sortKey = c.SortKey, format = c.Format }),
        defaultSort = Model.DefaultSort,
        defaultDirection = Model.DefaultDirection,
        pageSize = Model.PageSize,
        rowLink = Model.RowLink,
        emptyText = Model.EmptyText,
    });
}

<div id="@Model.Id" class="data-grid" data-grid-config="@config">
    @if (Model.Filters.Count > 0)
    {
        <div class="card card-body shadow-sm mb-3">
            <div class="row g-2 align-items-end">
                @foreach (var filter in Model.Filters)
                {
                    var selectId = $"{Model.Id}-{filter.Name}";
                    <div class="col-md-4">
                        <label for="@selectId" class="form-label small">@filter.Label</label>
                        <select id="@selectId" class="form-select" data-grid-filter="@filter.Name">
                            <option value="">All</option>
                            @foreach (var option in filter.Options)
                            {
                                <option value="@option.Value" selected="@(option.Value == filter.Selected)">@option.Text</option>
                            }
                        </select>
                    </div>
                }
            </div>
        </div>
    }

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover mb-0 grid-table">
                <thead class="table-light">
                    <tr>
                        @foreach (var column in Model.Columns)
                        {
                            if (column.SortKey is not null)
                            {
                                <th class="sortable" data-sort="@column.SortKey" role="button" tabindex="0">
                                    @column.Title <span class="sort-indicator text-muted"></span>
                                </th>
                            }
                            else
                            {
                                <th>@column.Title</th>
                            }
                        }
                    </tr>
                </thead>
                <tbody>
                    <tr><td colspan="@Model.Columns.Count" class="text-center text-muted py-4">Loading...</td></tr>
                </tbody>
            </table>
        </div>
        <div class="card-footer bg-white d-flex flex-wrap justify-content-between align-items-center gap-2">
            <span class="small text-muted" data-grid-summary></span>
            <div class="d-flex align-items-center gap-2">
                <select class="form-select form-select-sm w-auto" data-grid-page-size aria-label="Rows per page">
                    @foreach (var size in new[] { 10, 25, 50 })
                    {
                        <option value="@size" selected="@(size == Model.PageSize)">@size per page</option>
                    }
                </select>
                <nav aria-label="Pages"><ul class="pagination pagination-sm mb-0" data-grid-pager></ul></nav>
            </div>
        </div>
    </div>
</div>
