@model RentalApp.Web.Models.Applications.ReviewFormViewModel

<form asp-controller="Review" asp-action="Complete" method="post">
    <input type="hidden" asp-for="ApplicationId" />
    <div class="modal-header">
        <h5 class="modal-title">Complete review</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>
    <div class="modal-body">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

        <fieldset class="mb-3">
            <legend class="form-label fs-6">Outcome</legend>
            @foreach (var (outcome, label, hint) in new[]
            {
                (ReviewOutcome.Approve, "Approve", "Issues a twelve-month lease starting today."),
                (ReviewOutcome.Return, "Return", "Sends it back to the applicant to correct and resubmit."),
                (ReviewOutcome.Deny, "Deny", "Final. The applicant can apply again with a new application."),
            })
            {
                <div class="form-check">
                    <input asp-for="Outcome" type="radio" value="@outcome" id="outcome-@outcome" class="form-check-input" />
                    <label for="outcome-@outcome" class="form-check-label">
                        <span class="fw-semibold">@label</span> <span class="small text-muted">@hint</span>
                    </label>
                </div>
            }
            <span asp-validation-for="Outcome" class="text-danger small d-block"></span>
        </fieldset>

        <label asp-for="Comment" class="form-label">Comment <span class="small text-muted">(required for Return and Deny)</span></label>
        <textarea asp-for="Comment" rows="4" class="form-control"></textarea>
        <span asp-validation-for="Comment" class="text-danger small"></span>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Complete review</button>
    </div>
</form>
