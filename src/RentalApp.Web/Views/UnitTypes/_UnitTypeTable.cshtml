@model IReadOnlyList<RentalApp.Web.Models.Properties.UnitTypeRowViewModel>

<div id="unit-type-table" class="card shadow-sm">
    <table class="table mb-0">
        <thead class="table-light">
            <tr>
                <th>Name</th>
                <th>Status</th>
                <th class="text-end">Units using it</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var type in Model)
            {
                <tr>
                    <td class="fw-semibold">@type.Name</td>
                    <td>
                        <span class="badge @(type.IsActive ? "text-bg-success" : "text-bg-secondary")">@(type.IsActive ? "Active" : "Inactive")</span>
                    </td>
                    <td class="text-end">@type.UnitCount</td>
                    <td class="text-end">
                        <form asp-controller="UnitTypes" asp-action="ToggleActive" asp-route-id="@type.Id" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-secondary">@(type.IsActive ? "Deactivate" : "Activate")</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
