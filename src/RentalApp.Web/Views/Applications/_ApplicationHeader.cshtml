@model RentalApp.Web.Models.Applications.ApplicationPageViewModel

<div class="card shadow-sm mb-3">
    <div class="card-body d-flex flex-wrap justify-content-between gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <h1 class="h4 mb-0">Application #@Model.Id</h1>
                <partial name="_StatusBadge" model="Model.Status" />
            </div>
            <div>
                <span class="fw-semibold">@Model.Unit.PropertyName, unit @Model.Unit.UnitNumber</span>
                <span class="text-muted">&middot; @Model.Unit.UnitTypeName
                    &middot; @(Model.Unit.Bedrooms == 0 ? "Studio" : $"{Model.Unit.Bedrooms} bd")
                    &middot; @Model.Unit.MonthlyRent.ToString("C")/mo</span>
            </div>
            <div class="small text-muted">@Model.Unit.Address</div>
            <div class="small text-muted mt-1">
                @if (Model.IsManager)
                {
                    <span>Applicant: @Model.ApplicantAccountName &middot; </span>
                }
                Started @Model.CreatedAt.ToLocalTime().ToString("MMM d, yyyy")
                @if (Model.SubmittedAt is { } submitted)
                {
                    <span>&middot; Submitted @submitted.ToLocalTime().ToString("MMM d, yyyy")</span>
                }
            </div>
        </div>
        <div class="text-md-end">
            @if (Model.LeaseStart is { } start && Model.LeaseEnd is { } end)
            {
                <div class="alert alert-success py-2 mb-2">
                    Lease: @start.ToString("MMM d, yyyy") &ndash; @end.ToString("MMM d, yyyy")
                </div>
            }
            @if (Model.CanWithdraw)
            {
                <button type="button" class="btn btn-outline-danger btn-sm"
                        data-modal-url="@Url.Action("Withdraw", "Applications", new { id = Model.Id })" data-refresh="page">
                    Withdraw application
                </button>
            }
        </div>
    </div>
</div>

@if (Model.ReturnComment is not null && !Model.IsManager)
{
    <div class="alert alert-warning">
        <strong>Returned for correction:</strong> @Model.ReturnComment
        <div class="small mt-1">Update the sections below, then submit again from the Summary.</div>
    </div>
}
