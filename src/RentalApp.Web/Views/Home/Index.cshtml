@{
    ViewData["Title"] = "Welcome";
}

<div class="py-5 text-center">
    <h1 class="display-5 fw-semibold">Find your next home</h1>
    <p class="lead text-muted col-lg-7 mx-auto">
        Browse available apartments and apply online. Property managers review every application and issue a
        twelve-month lease on approval.
    </p>
    <div class="d-flex gap-2 justify-content-center">
        <a asp-controller="Account" asp-action="Register" class="btn btn-primary btn-lg">Sign up</a>
        <a asp-controller="Account" asp-action="Login" class="btn btn-outline-secondary btn-lg">Log in</a>
    </div>
</div>
