@model RentalApp.Web.Models.Properties.UnitFormViewModel
@{
    var isEdit = Model.Id is not null;
}

<form asp-controller="Units" asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@Model.Id" method="post">
    <input type="hidden" asp-for="PropertyId" />
    <div class="modal-header">
        <h5 class="modal-title">@(isEdit ? "Edit unit" : "Add unit")</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>
    <div class="modal-body">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="UnitNumber" class="form-label"></label>
                <input asp-for="UnitNumber" class="form-control" autofocus />
                <span asp-validation-for="UnitNumber" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="UnitTypeId" class="form-label"></label>
                <select asp-for="UnitTypeId" asp-items="Model.UnitTypeOptions" class="form-select">
                    <option value="">Choose...</option>
                </select>
                <span asp-validation-for="UnitTypeId" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Bedrooms" class="form-label"></label>
                <input asp-for="Bedrooms" class="form-control" min="0" max="10" />
                <span asp-validation-for="Bedrooms" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="MonthlyRent" class="form-label"></label>
                <div class="input-group">
                    <span class="input-group-text">$</span>
                    <input asp-for="MonthlyRent" type="number" step="0.01" min="1" class="form-control" />
                </div>
                <span asp-validation-for="MonthlyRent" class="text-danger small"></span>
            </div>
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Save</button>
    </div>
</form>
