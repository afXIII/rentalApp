@model RentalApp.Web.Models.Applications.ResidenceFormViewModel
@{
    var isEdit = Model.Id is not null;
}

<form asp-controller="Residences" asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@Model.Id" method="post">
    <input type="hidden" asp-for="ApplicationId" />
    <div class="modal-header">
        <h5 class="modal-title">@(isEdit ? "Edit residence" : "Add residence")</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>
    <div class="modal-body">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
        <div class="mb-3">
            <label asp-for="Address" class="form-label"></label>
            <input asp-for="Address" class="form-control" autofocus />
            <span asp-validation-for="Address" class="text-danger small"></span>
        </div>
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="LandlordName" class="form-label"></label>
                <input asp-for="LandlordName" class="form-control" />
                <span asp-validation-for="LandlordName" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="LandlordPhone" class="form-label"></label>
                <input asp-for="LandlordPhone" class="form-control" />
                <span asp-validation-for="LandlordPhone" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="MoveInDate" class="form-label"></label>
                <input asp-for="MoveInDate" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control" />
                <span asp-validation-for="MoveInDate" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="MoveOutDate" class="form-label"></label>
                <input asp-for="MoveOutDate" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control" />
                <span asp-validation-for="MoveOutDate" class="text-danger small"></span>
            </div>
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Save</button>
    </div>
</form>
